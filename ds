#!/usr/bin/env python3
# ds [Double-Struck Text Converter] - Converts text to mathematical double-struck (monospace bold) Unicode style

import subprocess

def get_clipboard():
    """Get clipboard content using wl-paste"""
    try:
        result = subprocess.run(
            ['wl-paste'],
            capture_output=True,
            text=True,
            check=True
        )
        return result.stdout
    except subprocess.CalledProcessError:
        print("Error: Could not read from clipboard.")
        return ""
    except FileNotFoundError:
        print("Error: wl-paste not found. Please install wl-clipboard:")
        print("  sudo apt install wl-clipboard  (Debian/Ubuntu)")
        print("  sudo dnf install wl-clipboard  (Fedora)")
        print("  sudo pacman -S wl-clipboard    (Arch)")
        return ""


def set_clipboard(text):
    """Set clipboard content using wl-copy"""
    try:
        subprocess.run(
            ['wl-copy'],
            input=text,
            text=True,
            check=True
        )
        return True
    except subprocess.CalledProcessError:
        print("Error: Could not write to clipboard.")
        return False
    except FileNotFoundError:
        print("Error: wl-copy not found. Please install wl-clipboard first.")
        return False


# Mapping tables
normal = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789.,;:?!'\"-()"

double_struck = (
    "𝙰𝙱𝙲𝙳𝙴𝙵𝙶𝙷𝙸𝙹𝙺𝙻𝙼𝙽𝙾𝙿𝚀𝚁𝚂𝚃𝚄𝚅𝚆𝚇𝚈𝚉"   # Uppercase
    "𝚊𝚋𝚌𝚍𝚎𝚏𝚐𝚑𝚒𝚓𝚔𝚕𝚖𝚗𝚘𝚙𝚚𝚛𝚜𝚝𝚞𝚟𝚠𝚡𝚢𝚣"   # Lowercase
    "𝟶𝟷𝟸𝟹𝟺𝟻𝟼𝟽𝟾𝟿"                     # Numbers
    ".,;:?!'\"-()"                          # Punctuation
)

# Create translation table
trans_table = str.maketrans(normal, double_struck)

def convert_to_double_struck(text: str) -> str:
    """Convert text to the requested mathematical double-struck style."""
    return text.translate(trans_table)

if __name__ == "__main__":
    # Get clipboard content
    clipboard_text = get_clipboard()
    
    if clipboard_text:
        # Process the text
        processed_text = convert_to_double_struck(clipboard_text.strip())
        
        # Copy back to clipboard
        if set_clipboard(processed_text):
            print("✓ Text converted to double-struck style and copied to clipboard!")
        else:
            print("✗ Failed to copy to clipboard.")
    else:
        print("✗ No text found in clipboard or error reading clipboard.")