#!/usr/bin/env python3
"""
rns - Replace literal "\\n" sequences with actual newlines from the clipboard.

Usage:
    ./rns

Description:
    Reads text from the Wayland clipboard (using `wl-paste`), replaces all occurrences
    of the two-character sequence "\\n" with an actual newline character, and writes
    the result back to the clipboard (using `wl-copy`). Useful when text contains
    escaped newline sequences (for example, JSON or pasted literal strings) and you
    want to convert them into real line breaks.

Examples:
    Input clipboard: "Line1\\nLine2\\nLine3"
    After running `./rns`, clipboard becomes:
    Line1
    Line2
    Line3
"""

import subprocess
import sys


def clipboard_paste():
    """Return clipboard contents as a string (Wayland: `wl-paste`)."""
    proc = subprocess.run(['wl-paste'], capture_output=True)
    proc.check_returncode()
    return proc.stdout.decode('utf-8')


def clipboard_copy(text: str):
    """Copy `text` to the clipboard (Wayland: `wl-copy`)."""
    proc = subprocess.run(['wl-copy'], input=text.encode('utf-8'))
    proc.check_returncode()


def main():
    try:
        text = clipboard_paste()
    except subprocess.CalledProcessError as e:
        print('Error reading clipboard:', e, file=sys.stderr)
        sys.exit(1)

    # Replace literal backslash + n with an actual newline
    new_text = text.replace('\\n', '\n')

    try:
        clipboard_copy(new_text)
    except subprocess.CalledProcessError as e:
        print('Error writing clipboard:', e, file=sys.stderr)
        sys.exit(1)


if __name__ == '__main__':
    main()
